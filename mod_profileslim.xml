<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1" client="site" method="upgrade">
	<name>Joomla Profile Slim Display</name>
	<author>Jayden Russell</author>
	<creationDate>September 2026</creationDate>
	<copyright>Copyright (C) 2026 Simcoe Curling Club</copyright>
	<license>GNU General Public License v2 or later</license>
	<version>1.10.1</version>
	<description>Standalone Joomla module: displays the logged-in user's display name and avatar in the top header navbar using Joomla's built-in profile system. Optional Community Builder awareness — when CB is installed the profile link follows CB's canonical View Profile menu item.</description>
	<updateservers>
		<server type="extension" name="Joomla Profile Slim Display Update" priority="1">https://raw.githubusercontent.com/jaydenrussell/mod-profileslim/master/update.xml</server>
	</updateservers>
	<files>
		<filename module="mod_profileslim">mod_profileslim.php</filename>
		<filename>helper.php</filename>
		<filename>cbmenu.php</filename>
		<filename>index.html</filename>
		<folder>language</folder>
		<folder>css</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_profileslim.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_profileslim.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="profile_url"
					type="text"
					label="MOD_PROFILESLIM_PROFILE_URL_LABEL"
					description="MOD_PROFILESLIM_PROFILE_URL_DESC"
					default=""
					size="50"
					filter="url"
				/>
				<field
					name="profile_itemid"
					type="text"
					label="MOD_PROFILESLIM_PROFILE_ITEMID_LABEL"
					description="MOD_PROFILESLIM_PROFILE_ITEMID_DESC"
					default="0"
					size="10"
					filter="integer"
				/>
				<field
					name="avatar_base_path"
					type="text"
					label="MOD_PROFILESLIM_AVATAR_BASE_PATH_LABEL"
					description="MOD_PROFILESLIM_AVATAR_BASE_PATH_DESC"
					default="/images/"
					size="40"
					filter="string"
				/>
				<field
					name="avatar_size"
					type="list"
					label="MOD_PROFILESLIM_AVATAR_SIZE_LABEL"
					description="MOD_PROFILESLIM_AVATAR_SIZE_DESC"
					default="32"
				>
					<option value="16">16px</option>
					<option value="24">24px</option>
					<option value="32" selected="selected">32px</option>
					<option value="36">36px</option>
					<option value="40">40px</option>
				</field>
				<field
					name="avatar_align"
					type="list"
					label="MOD_PROFILESLIM_AVATAR_ALIGN_LABEL"
					description="MOD_PROFILESLIM_AVATAR_ALIGN_DESC"
					default="top"
				>
					<option value="none">None</option>
					<option value="top" selected="selected">Top</option>
					<option value="center">Center</option>
					<option value="bottom">Bottom</option>
				</field>
				<field
					name="container_padding"
					type="text"
					label="MOD_PROFILESLIM_CONTAINER_PADDING_LABEL"
					description="MOD_PROFILESLIM_CONTAINER_PADDING_DESC"
					default="0 0 0 0"
					size="20"
					filter="string"
				/>
				<field
					name="container_margin"
					type="text"
					label="MOD_PROFILESLIM_CONTAINER_MARGIN_LABEL"
					description="MOD_PROFILESLIM_CONTAINER_MARGIN_DESC"
					default="0"
					size="20"
					filter="string"
				/>
				<field
					name="avatar_db_fallback"
					type="radio"
					label="MOD_PROFILESLIM_AVATAR_DB_FALLBACK_LABEL"
					description="MOD_PROFILESLIM_AVATAR_DB_FALLBACK_DESC"
					default="0"
					class="btn-group btn-group-yesno"
				>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>